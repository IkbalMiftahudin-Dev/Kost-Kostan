# Keamanan & Konfigurasi Apache untuk InfinityFree / cPanel
DirectoryIndex index.php
Options -Indexes

# Blokir akses langsung ke file tersembunyi (.git, .gitignore, .htaccess)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
