# PostgreSQL Connection String (Vercel Storage / Neon / Supabase)
# Jika dibiarkan kosong, aplikasi otomatis berjalan dalam Mode Demo (in-memory) agar tetap bisa preview.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Secret acak untuk menandatangani cookie sesi login Admin (isi string panjang & acak di Vercel)
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter-di-vercel"
